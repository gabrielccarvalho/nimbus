{
  "name": "nimbus",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "docker compose up -d --wait db && pnpm db:migrate && concurrently -k -n next,worker -c blue,magenta \"next dev\" \"pnpm worker:dev\"",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --conditions=react-server worker/index.ts",
    "docker:worker": "docker build --platform linux/amd64 -f Dockerfile.worker -t nimbus-worker .",
    "worker:dev": "WORKER_SHUTDOWN_GRACE_MS=1000 tsx watch --conditions=react-server worker/index.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit --project component --project integration",
    "test:watch": "vitest --project unit --project component",
    "test:unit": "vitest run --project unit --project component",
    "test:integration": "vitest run --project integration",
    "test:heavy": "vitest run --project heavy",
    "test:s3": "vitest run --project s3",
    "test:coverage": "vitest run --project unit --project component --project integration --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "doctor": "tsx --conditions=react-server scripts/doctor.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:import-sqlite": "tsx --conditions=react-server scripts/migrate-sqlite.ts",
    "prepare": "husky",
    "setup:vision": "tsx scripts/setup-vision.ts",
    "storage:push": "tsx --conditions=react-server scripts/storage-push.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/lib-storage": "^3.1177.0",
    "@aws-sdk/s3-request-presigner": "^3.1177.0",
    "@base-ui/react": "^1.9.0",
    "@electric-sql/pglite": "^0.5.17",
    "@hookform/resolvers": "^7.0.8",
    "@mediapipe/tasks-vision": "1.2.2",
    "@next/env": "16.4.6",
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.2",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "yazl": "3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "better-sqlite3": "^13.2.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "msw": "^3.0.7",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,yml}": [
      "prettier --write"
    ]
  }
}
