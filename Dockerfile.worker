# syntax=docker/dockerfile:1

FROM --platform=linux/amd64 debian:trixie-slim AS whisper
ARG WHISPER_CPP_VERSION=v1.9.5
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential ca-certificates cmake git \
  && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch "$WHISPER_CPP_VERSION" https://github.com/ggml-org/whisper.cpp /src
WORKDIR /src
# GGML_NATIVE tunes for whichever CPU runs the build (often an emulator), so
# target AVX2 explicitly.
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
    -DGGML_NATIVE=OFF -DGGML_AVX=ON -DGGML_AVX2=ON -DGGML_FMA=ON -DGGML_F16C=ON \
    -DWHISPER_BUILD_TESTS=OFF \
  && cmake --build build --config Release --target whisper-cli -j "$(nproc)"

FROM --platform=linux/amd64 debian:trixie-slim AS model
ARG WHISPER_MODEL_FILE=ggml-large-v3-turbo-q5_0.bin
ARG WHISPER_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/5359861c739e955e79d9a303bcbc70fb988958b1/${WHISPER_MODEL_FILE}
# Set to empty to skip the check when WHISPER_MODEL_URL points elsewhere.
ARG WHISPER_MODEL_SHA256=394221709cd5ad1f40c46e6031ca61bce88931e6e088c188294c6d5a55ffa7e2
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*
RUN mkdir /models \
  && curl -fL --retry 3 -o "/models/$WHISPER_MODEL_FILE" "$WHISPER_MODEL_URL" \
  && if [ -n "$WHISPER_MODEL_SHA256" ]; then \
    echo "$WHISPER_MODEL_SHA256  /models/$WHISPER_MODEL_FILE" | sha256sum -c -; \
  fi

FROM --platform=linux/amd64 node:24-trixie-slim AS base
ARG PNPM_VERSION=11.24.0
RUN npm install -g "pnpm@$PNPM_VERSION"
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# Skips husky's prepare hook and native builds only the web or scripts use
# (better-sqlite3, sharp); esbuild ships its binary as a platform package.
RUN pnpm install --prod --frozen-lockfile --ignore-scripts

FROM base
ARG WHISPER_MODEL_FILE=ggml-large-v3-turbo-q5_0.bin
ARG YTDLP_VERSION=2026.10.26
ARG YTDLP_SHA256=767ba9dce7052aa196f8b12652f433d76de128ba168966fa84b6394d5e6c6795
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates ffmpeg libgomp1 tini \
  && rm -rf /var/lib/apt/lists/* \
  && ffmpeg -hide_banner -filters | grep -q " ass " \
  && ffmpeg -hide_banner -encoders | grep -q libx264
ADD --checksum=sha256:${YTDLP_SHA256} --chmod=755 \
  https://github.com/yt-dlp/yt-dlp/releases/download/${YTDLP_VERSION}/yt-dlp_linux /usr/local/bin/yt-dlp
COPY --from=whisper /src/build/bin/whisper-cli /usr/local/bin/whisper-cli
COPY --from=model /models /models
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# 30 s inside the daemon's terminationGracePeriodSeconds (600) in vercel.json.
ENV NODE_ENV=production \
  NIMBUS_ROLE=worker \
  SCRATCH_DIR=/tmp/nimbus \
  WORKER_SHUTDOWN_GRACE_MS=570000 \
  WHISPER_MODEL=/models/${WHISPER_MODEL_FILE}
RUN install -d -o node -g node /tmp/nimbus
USER node
ENTRYPOINT ["tini", "--"]
CMD ["node", "--conditions=react-server", "--import", "tsx", "worker/index.ts"]
