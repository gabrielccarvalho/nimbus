# Where the database, uploads and renders live (gitignored)
DATA_DIR=./data
# DATABASE_PATH=./data/app.db

# Binaries (must include libass + libx264, see README)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Transcription: whisper | fake
TRANSCRIBER=whisper
WHISPER_BIN=whisper-cli
WHISPER_MODEL=./models/ggml-base.en.bin
WHISPER_LANGUAGE=auto
WHISPER_THREADS=4

# Default highlight selector for new projects: anthropic | manual | heuristic
HIGHLIGHT_SELECTOR=heuristic
# Server-side only, never exposed to the browser
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Uploads (bytes, default 20 GiB)
MAX_UPLOAD_BYTES=21474836480

# Worker
WORKER_CONCURRENCY=2
WORKER_RENDER_CONCURRENCY=1
WORKER_POLL_MS=1000

# trace | debug | info | warn | error | silent
LOG_LEVEL=info
