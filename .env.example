# Uploads and renders (gitignored)
DATA_DIR=./data
# Per-job work files, removed when each job settles (default: <os tmpdir>/nimbus)
# SCRATCH_DIR=/tmp/nimbus
# With s3, inputs downloaded by the worker are kept under SCRATCH_DIR/cache up
# to this many bytes (default 64 GiB), least recently used evicted first
# SCRATCH_CACHE_BYTES=68719476736
# Where media lives: local (DATA_DIR) | s3 (any S3-compatible bucket)
STORAGE_DRIVER=local
# MinIO from docker-compose.yml (`docker compose --profile s3 up -d`). For R2 use
# https://<account>.r2.cloudflarestorage.com. For AWS leave the endpoint unset
# and set S3_REGION to the bucket's region (auto only works with an endpoint).
# S3_ENDPOINT=http://localhost:9010
# S3_REGION=auto
# S3_BUCKET=nimbus
# S3_ACCESS_KEY_ID=nimbus
# S3_SECRET_ACCESS_KEY=nimbus-secret
# S3_FORCE_PATH_STYLE=true
# Endpoint browsers reach, when it differs from S3_ENDPOINT (e.g. the worker and
# web talk to http://minio:9000 inside docker compose); used only to sign URLs
# S3_PUBLIC_ENDPOINT=http://localhost:9010
# Postgres from docker-compose.yml (`docker compose up -d db`)
DATABASE_URL=postgres://nimbus:nimbus@localhost:5442/nimbus
# Connections per process (default 10); lower it on serverless hosts
# DATABASE_POOL_MAX=10

# What this process runs, for pnpm run doctor: web (skips the ffmpeg, whisper and
# yt-dlp checks) | worker | all (default)
# NIMBUS_ROLE=all

# Binaries (must include libass + libx264, see README)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# libx264 (default) | auto (first hardware H.264 encoder found) | h264_videotoolbox | h264_nvenc | h264_qsv
VIDEO_ENCODER=libx264

# Transcription: whisper | fake
TRANSCRIBER=whisper
WHISPER_BIN=whisper-cli
WHISPER_MODEL=./models/ggml-large-v3-turbo-q5_0.bin
WHISPER_LANGUAGE=auto
WHISPER_THREADS=4

# Importing from a link: yt-dlp | fake (FAKE_DOWNLOAD_FILE is copied instead)
DOWNLOADER=yt-dlp
YTDLP_PATH=yt-dlp
# YouTube's "confirm you're not a bot" check needs signed-in cookies: a browser
# yt-dlp can read (chrome, firefox, safari, ...), dia (read by Nimbus, e.g.
# dia:Profile 1; macOS asks once for Keychain access) or a cookies.txt path
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES=
# The contents of a cookies.txt, for hosts without a persistent disk. Written to
# SCRATCH_DIR/ytdlp-cookies.txt (0600) on first use; the two settings above win
YTDLP_COOKIES_TEXT=

# Default highlight selector for new projects: anthropic | manual | heuristic
HIGHLIGHT_SELECTOR=heuristic
# Server-side only, never exposed to the browser
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Model that watches frames of each candidate; defaults to ANTHROPIC_MODEL
ANTHROPIC_REVIEW_MODEL=

# Uploads (bytes, default 20 GiB)
MAX_UPLOAD_BYTES=21474836480

# Worker
WORKER_CONCURRENCY=2
WORKER_RENDER_CONCURRENCY=1
WORKER_POLL_MS=1000
# On SIGTERM running jobs get this long to finish before they're aborted and
# retried. Keep it under the host's kill timeout: 570000 on Vercel (daemon
# terminationGracePeriodSeconds 600); pnpm worker:dev uses 1000 because tsx
# watch SIGKILLs after 5 s and would orphan ffmpeg
# WORKER_SHUTDOWN_GRACE_MS=25000
# GET /healthz answers 200 while the job loop keeps polling; 0 turns it off
# WORKER_HEALTH_PORT=8787

# trace | debug | info | warn | error | silent
LOG_LEVEL=info

# Accounts (Better Auth). Both secrets are required in production: 32+ random
# characters each, e.g. `openssl rand -base64 32`. Development falls back to
# fixed, insecure values.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Set by Vercel on every deployment; https://$VERCEL_URL and the branch's
# https://$VERCEL_BRANCH_URL are trusted so previews can sign in.
# BETTER_AUTH_URL stays the production URL.
# VERCEL_URL=
# VERCEL_BRANCH_URL=
# Encrypts workspace secrets such as the Claude API key (AES-256-GCM)
NIMBUS_SECRET_KEY=
# Optional sign-in and channel providers; their buttons hide until set.
# Google also powers the YouTube channel, Twitch the Twitch channel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# YouTube publishing: "fake" skips the network. Uploads (videos.insert) have
# their own daily bucket; everything else draws on the 10,000-unit quota.
YOUTUBE_CLIENT=http
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_DAILY_UPLOADS=100
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Creator subscriptions through AbacatePay (API v2). Without a key and a
# product, Plan & usage offers no checkout. "fake" skips the network.
# Create the product once with `pnpm billing:product`, then point a v2 webhook
# at <BETTER_AUTH_URL>/api/billing/webhook with the subscription.* events.
BILLING_CLIENT=abacatepay
ABACATEPAY_API_KEY=
ABACATEPAY_CREATOR_PRODUCT_ID=
ABACATEPAY_WEBHOOK_SECRET=
