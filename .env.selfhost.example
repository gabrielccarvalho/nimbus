# Copy to .env.selfhost, then:
#   docker compose -f docker-compose.yml -f docker-compose.selfhost.yml \
#     --env-file .env.selfhost --profile selfhost up -d --build
# Compose reads this file for its own settings and passes it to the app
# containers; anything from .env.example can be added.

# Required: 32+ random characters each, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
NIMBUS_SECRET_KEY=
# Required: MinIO's root user, also the app's S3 keys
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Where browsers reach the app and MinIO; keep these in step
BETTER_AUTH_URL=http://localhost:3000
NIMBUS_WEB_PORT=3000
MINIO_CORS_ORIGIN=http://localhost:3000
NIMBUS_S3_PORT=9010
S3_PUBLIC_ENDPOINT=http://localhost:9010

# Highlights: heuristic works without a key
HIGHLIGHT_SELECTOR=heuristic
ANTHROPIC_API_KEY=

# Optional sign-in and channel providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# yt-dlp can't read a browser inside the container; paste a cookies.txt instead
YTDLP_COOKIES_TEXT=
