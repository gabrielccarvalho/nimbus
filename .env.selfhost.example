# Copy to .env.selfhost for `docker compose --profile selfhost up -d --build`.
# Database and MinIO settings come from docker-compose.yml; set only what's
# yours here. Anything from .env.example can be added.

# Required: 32+ random characters each, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
NIMBUS_SECRET_KEY=
# Where browsers reach the app. On another port, also export NIMBUS_WEB_PORT and
# MINIO_CORS_ORIGIN before `docker compose up` (they're read by compose itself)
BETTER_AUTH_URL=http://localhost:3000

# Highlights: heuristic works without a key
HIGHLIGHT_SELECTOR=heuristic
ANTHROPIC_API_KEY=

# Optional sign-in and channel providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# yt-dlp can't read a browser inside the container; paste a cookies.txt instead
YTDLP_COOKIES_TEXT=
