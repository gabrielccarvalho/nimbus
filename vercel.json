{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "if [ \"$VERCEL_ENV\" = production ]; then pnpm db:migrate; fi && pnpm setup:vision && pnpm build",
  "daemons": {
    "worker": {
      "root": "./",
      "entrypoint": "Dockerfile.worker",
      "instances": { "iad1": 0 },
      "resources": { "requests": { "memory": "2Gi" } },
      "terminationGracePeriodSeconds": 600,
      "livenessProbe": {
        "httpGet": { "port": 8787, "path": "/healthz" },
        "initialDelaySeconds": 30
      }
    }
  }
}
